{
  "name": "gouxing-cad",
  "version": "1.2.2",
  "description": "构形 CAD：操作专业 CAD 的桌面对话 Harness 助手",
  "scripts": {
    "setup": "node scripts/setup-cad.mjs",
    "samples:import": "node scripts/import-samples.mjs",
    "samples:export": "node scripts/export-samples.mjs",
    "repo:update": "node scripts/update-repo.mjs",
    "start": "node scripts/start-desktop.mjs",
    "start:web": "node scripts/start-cad.mjs",
    "desktop:runtime": "node node_modules/electron/install.js",
    "harness": "dsh web",
    "status": "node scripts/start-cad.mjs --check",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/test.mjs desktop",
    "start:headless": "dsh web --no-open",
    "dsh": "dsh",
    "test:prototype": "node scripts/test.mjs prototype",
    "test:runtime": "node desktop/test/run-runtime-layer.mjs",
    "test:shell": "node desktop/test/run-shell.mjs",
    "test:stream-live": "node desktop/test/run-shell.mjs --model"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1"
  },
  "private": true,
  "devDependencies": {
    "electron": "45.3.1"
  }
}
